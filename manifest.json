{
  "manifest_version": 3,
  "name": "Lotecando para Loterias Caixa",
  "short_name": "Lotecando",
  "version": "1.0.0",
  "description": "Põe no carrinho da Caixa os jogos do Lotecando (Loteca e Mega-Sena). Não oficial; uso por conta e risco do usuário, sem garantia.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lotecando para Loterias Caixa",
    "default_popup": "src/popup.html"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.loteriasonline.caixa.gov.br/*"]
}
